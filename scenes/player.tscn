[gd_scene load_steps=4 format=3 uid="uid://player_scene"]

[ext_resource type="Script" path="res://scripts/player_controller.gd" id="1_player"]
[ext_resource type="PackedScene" path="res://scenes/touch_ui.tscn" id="2_touch_ui"]

[sub_resource type="CapsuleShape3D" id="CapsuleShape3D_1"]
radius = 0.4
height = 1.8

;; ==========================================================================
;; AXEV CRIME — Player Scene
;; ==========================================================================
;;
;; HIERARQUIA ESPERADA (após integração dos GLBs Quaternius):
;;
;; Player (CharacterBody3D)
;; ├── CollisionShape3D        — cápsula de colisão, NÃO mexer
;; ├── CharacterMesh (Node3D)  — pivot de rotação; recebe o GLB do personagem
;; │   └── [character.glb]     — Universal Base Characters (Regular Male)
;; │       └── Skeleton3D      — esqueleto humanoid retargetado
;; ├── AnimationRoot (Node3D)  — GLB da biblioteca de animações (separado)
;; │   └── [animations.glb]    — Universal Animation Library 1 (Standard)
;; │       └── AnimationPlayer — fonte das animações (retargetadas para o char)
;; ├── CameraPivot (Node3D)
;; │   └── Camera3D
;; └── TouchUI (instância)
;;
;; PASSOS DE INTEGRAÇÃO (ver assets/models/character/README.md):
;; 1. Descarregar e colocar os GLBs em assets/models/character/
;; 2. Importar em Godot com retargeting humanoid activo
;; 3. Arrastar character.glb para CharacterMesh
;; 4. Arrastar animations.glb para AnimationRoot
;; 5. O player_controller.gd detecta tudo automaticamente
;;
;; O jogo funciona sem os GLBs (personagem invisível, lógica intacta).
;; ==========================================================================

[node name="Player" type="CharacterBody3D"]
script = ExtResource("1_player")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.9, 0)
shape = SubResource("CapsuleShape3D_1")

[node name="CharacterMesh" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0)

[node name="AnimationRoot" type="Node3D" parent="."]
visible = false

[node name="CameraPivot" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.6, 0)

[node name="Camera3D" type="Camera3D" parent="CameraPivot"]
transform = Transform3D(1, 0, 0, 0, 0.966, 0.259, 0, -0.259, 0.966, 0, 0, 3)

[node name="TouchUI" parent="." instance=ExtResource("2_touch_ui")]
